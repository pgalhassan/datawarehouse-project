/* vérification de redondances ou de valeurs non fournies */
SELECT * FROM bronze.crm_cust_info
WHERE cst_id in (
SELECT cst_id FROM bronze.crm_cust_info
GROUP BY cst_id  HAVING count(*) >1) ORDER BY cst_create_date DESC
/* transformation et correction */
SELECT * FROM 
(SELECT *,
ROW_NUMBER() OVER (PARTITION BY cst_id ORDER BY cst_create_date DESC) AS column_number FROM bronze.crm_cust_info)t 
WHERE column_number = 1 AND cst_id IS NOT NULL


